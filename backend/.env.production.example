# Template for the VPS. Copy to backend/.env on the server and fill in the blanks.
# Real values never belong in this file or in git. Generate APP_KEY on the server
# with: php artisan key:generate

APP_NAME="DeenMate AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://deen.sohojware.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deenmate_ai
DB_USERNAME=deenmate
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=deen.sohojware.dev
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="DeenMate AI"

PASSWORD_RESET_URL=deenmate://reset-password

# Proxies allowed to set X-Forwarded-* headers. Comma separated, for example a load
# balancer's address. With nginx on the same machine and no proxy in front, keep this.
# Behind Cloudflare's proxy, use its published ranges. See docs/DEPLOYMENT.md.
TRUSTED_PROXIES=127.0.0.1

SANCTUM_TOKEN_EXPIRATION=525600

# anthropic | openai_compatible | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_BASE_URL=
AI_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=8000
AI_REQUEST_TIMEOUT=120
AI_HISTORY_TURNS=6
AI_RETRIEVAL_LIMIT=8
AI_MAX_QUESTION_CHARS=1500
AI_REQUESTS_PER_MINUTE=6
AI_DAILY_TOKEN_LIMIT=60000

QURAN_API_BASE=https://api.alquran.cloud/v1
QURAN_TEXT_EDITION=quran-uthmani
QURAN_TRANSLITERATION_EDITION=en.transliteration
QURAN_TRANSLATION_EDITIONS=en.pickthall,bn.bengali
HADITH_API_BASE=https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1/editions

DATA_EXPORT_TTL_HOURS=72

FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
