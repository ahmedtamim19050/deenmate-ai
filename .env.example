# Local development with Laragon. Copy to backend/.env. For the server, use .env.production.example.

APP_NAME="DeenMate AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://deenmate-ai.test

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=deenmate_ai
DB_USERNAME=root
DB_PASSWORD=

# Use redis where available. The database driver works anywhere.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="DeenMate AI"

# Link placed in password reset emails.
PASSWORD_RESET_URL=deenmate://reset-password

# Comma separated proxy addresses, if the API sits behind a load balancer.
TRUSTED_PROXIES=127.0.0.1

# Sanctum token lifetime in minutes. 525600 is one year.
SANCTUM_TOKEN_EXPIRATION=525600

# AI assistant. Leave the provider as none until you have a key: the app then shows
# an honest "not set up" state rather than any answer.
# anthropic | openai_compatible | none
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# Required for openai_compatible, for example https://your-provider.example/v1
AI_BASE_URL=
AI_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=8000
AI_REQUEST_TIMEOUT=120
AI_HISTORY_TURNS=6
AI_RETRIEVAL_LIMIT=8
AI_MAX_QUESTION_CHARS=1500
AI_REQUESTS_PER_MINUTE=6
AI_DAILY_TOKEN_LIMIT=60000

# Quran and Hadith importers. Check the licence of every edition before production use.
QURAN_API_BASE=https://api.alquran.cloud/v1
QURAN_TEXT_EDITION=quran-uthmani
QURAN_TRANSLITERATION_EDITION=en.transliteration
QURAN_TRANSLATION_EDITIONS=en.pickthall,bn.bengali
HADITH_API_BASE=https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1/editions

DATA_EXPORT_TTL_HOURS=72

# Optional push announcements. Prayer reminders are local and do not need this.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
